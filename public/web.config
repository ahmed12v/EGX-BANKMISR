<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Requires IIS URL Rewrite + ARR, with Enable Proxy set at server level. -->
    <rewrite>
      <rules>
        <rule name="BANKMISR login" stopProcessing="true">
          <match url="^BANKMISR/login$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/GetIConnectLogin" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR tracking" stopProcessing="true">
          <match url="^BANKMISR/tracking$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/TrackDetails" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR reference-search" stopProcessing="true">
          <match url="^BANKMISR/reference-search$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/AWBSearchDetailed" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR reference-options" stopProcessing="true">
          <match url="^BANKMISR/reference-options$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/GetHelpData" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR complaints" stopProcessing="true">
          <match url="^BANKMISR/complaints$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/SearchQuery" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR complaint-types" stopProcessing="true">
          <match url="^BANKMISR/complaint-types$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/MasterList" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR complaint-number" stopProcessing="true">
          <match url="^BANKMISR/complaint-number$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/GetNewComplaintNo" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR account-details" stopProcessing="true">
          <match url="^BANKMISR/account-details$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/GetAccountDetails" appendQueryString="false" />
        </rule>
        <rule name="BANKMISR create-complaint" stopProcessing="true">
          <match url="^BANKMISR/create-complaint$" ignoreCase="false" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
          <action type="Rewrite" url="https://egxpress.me/IconnectSecure/IntegraOntrackService.svc/CreateComplaint" appendQueryString="false" />
        </rule>
        <rule name="Reject unknown BANKMISR requests" stopProcessing="true">
          <match url="^BANKMISR(?:/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Endpoint not found." />
        </rule>
        <rule name="Angular routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{HTTP_ACCEPT}" pattern="text/html" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument>
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>
  </system.webServer>
</configuration>
